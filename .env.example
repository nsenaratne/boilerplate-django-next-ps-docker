# Optional. Everything has a sensible default for local development.
# cp .env.example .env   and edit what you need.

COMPOSE_PROJECT_NAME=app

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Host ports (dev stack)
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend (dev) — URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=/api/v1

# --- Production stack only (docker-compose.prod.yml) ---
HTTP_PORT=80
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_SSL_REDIRECT=false
PROD_PUBLIC_API_URL=/api/v1
